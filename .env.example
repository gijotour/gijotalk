# ------------------------------------------------------------------
# GIJO Talk 환경변수
# ------------------------------------------------------------------

# [필수] Gemini API 키 — AI 맞춤 회화 생성에 사용됩니다.
# 없어도 회화·발음·전광판·연속듣기 등 나머지 기능은 전부 동작합니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [권장] 접근 코드.
# 지인에게는 https://앱주소/?key=<이 값> 형태로 링크를 보냅니다.
# 설정하면 /api/gemini/* 호출에 이 코드가 필요합니다.
# 링크가 유출됐을 때 Gemini 비용이 새는 것을 막습니다.
# 비워두면 검사를 건너뜁니다(로컬 개발용).
APP_ACCESS_CODE=""

# [선택] 오디오 재생성용 Google Cloud TTS 키.
#   npm run audio -- --backend=google
# macOS 내장 음성 대신 실제 필리핀어(fil-PH) 음성으로 다시 만들 때만 필요합니다.
# 앱 런타임에는 필요 없습니다 — 생성된 오디오 파일만 배포됩니다.
GOOGLE_TTS_API_KEY=""

# [자동] 배포 플랫폼이 주입합니다. 직접 설정하지 않아도 됩니다.
# PORT=8080
# NODE_ENV=production

# APP_URL: 호스팅 주소. AI Studio 배포 시 자동 주입됩니다.
APP_URL="MY_APP_URL"
